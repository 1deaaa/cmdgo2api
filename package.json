{
  "name": "commandcode-proxy",
  "version": "1.0.0",
  "type": "module",
  "description": "Command Code → OpenAI 兼容代理",
  "license": "MIT",
  "author": "1deaaa (https://github.com/1deaaa)",
  "contributors": [
    "MAXeaglet (https://github.com/MAXeaglet) — original commandcode-proxy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1deaaa/cmdgo2api.git"
  },
  "homepage": "https://github.com/1deaaa/cmdgo2api#readme",
  "bugs": {
    "url": "https://github.com/1deaaa/cmdgo2api/issues"
  },
  "main": "proxy.mjs",
  "scripts": {
    "start": "node proxy.mjs",
    "dev": "node --watch proxy.mjs",
    "test": "node --test",
    "build": "npm run web:install && npm run web:build",
    "web:install": "npm --prefix web ci --ignore-scripts --no-audit --no-fund",
    "web:build": "npm --prefix web run build",
    "web:dev": "npm --prefix web run dev",
    "test:upstream": "node --test test/*.test.mjs",
    "test:bun": "bun test",
    "docker:build": "docker build -t commandcode-proxy:latest .",
    "docker:build:multi": "docker buildx build --platform linux/amd64,linux/arm64 -t commandcode-proxy:latest ."
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
