# Dependencies
node_modules/
test/
dist/
# Logs and command output
*.log
stdout.txt
stderr.txt

# Runtime credentials / account tokens — NEVER commit these.
# The proxy stores them in ~/.config/commandcode-proxy/ and ~/.commandcode/ by default,
# but a custom runtime directory can drop them into the repo.
.commandcode/
.opencode/
credentials.env
auth.json
accounts.json
settings.json
request-log.jsonl
.request-log.*.tmp

# Environment files
.env
.env.*

# Temporary / scratch
temp/

# Captured CLI traffic (contains upstream auth headers — must never be published)
captured-requests/

# Local agent / tooling state（AGENTS.md 为项目维护指南，需要入库）
.omo/
.agents/
!AGENTS.md

# Archives
*.zip

# Keys
*.pem
*.key

# Python
__pycache__/
*.py[cod]

# OS junk
.DS_Store
Thumbs.db
